# --- Clockify ---
# Profile -> Settings -> API -> generate key
CLOCKIFY_API_KEY=
CLOCKIFY_WORKSPACE_ID=
CLOCKIFY_USER_ID=

# --- Contract ---
# Daily target while on a working day, ISO-8601 duration or "7h"/"7.8h"
DAILY_TARGET=8h
WORKING_DAYS=MON,TUE,WED,THU,FRI
TIMEZONE=Europe/Berlin
# First day the balance is counted from (YYYY-MM-DD)
BALANCE_START=2023-09-05
# Overtime does not carry into the next year: YEARLY resets the balance each
# 1 January. NEVER keeps one running total across all years.
BALANCE_RESET=YEARLY
# Balance carried in on BALANCE_START itself, e.g. "0", "+12h30m", "-3h"
BALANCE_OPENING=0
# German state for public holidays (BW BY BE BB HB HH HE MV NI NW RP SL SN ST SH TH)
HOLIDAY_STATE=NI
# Company days off that are not public holidays (MM-DD[:name])
COMPANY_CLOSURE_DAYS=12-24:Heiligabend,12-31:Silvester

# --- Server ---
# Daily time (HH:MM, in TIMEZONE) at which the server pulls Clockify again.
# 00:00 closes the day just ended, so it lands in the balance overnight.
# It also refreshes on startup and on the Refresh button. off = never.
# Read by Docker; start-server.bat sets its own.
REFRESH_AT=00:00
# Usually leave empty: IPs, plain names (homeserver) and LAN names
# (*.local, *.lan, *.fritz.box, ...) always work. Only a real domain, e.g.
# behind a reverse proxy, needs listing here. Comma separated, * = any.
ALLOWED_HOSTS=
# Docker only: port published on the home server
OVERTIME_PORT=8080

# --- Timerevision (unused: absences come from the CSV export, not an API) ---
TIMEREVISION_BASE_URL=
TIMEREVISION_USERNAME=
