{
  "name": "overtime-overview",
  "version": "1.0.0",
  "private": true,
  "description": "Flextime balance from Clockify time entries and Timerevision absences, with an HTML dashboard",
  "type": "module",
  "scripts": {
    "report": "tsx scripts/report.ts",
    "dashboard": "tsx scripts/dashboard.ts",
    "import": "tsx scripts/import-absences.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "serve": "node server/serve.cjs",
    "typecheck": "tsc --noEmit",
